# Mosquitto password file template
# Automatically generated inside container at /mosquitto/data/password.txt via mosquitto/docker-entrypoint.sh
# Or generate manually via: mosquitto_passwd -c mosquitto/config/password.txt <username>
#
# Service & Admin Accounts:
# aiot_backend:<password_hash>
# admin:<password_hash>
#
# Per-Device Accounts (matching hardwareId in tools/iot-simulator/config/rooms.json for %u ACL):
# ESP32S3_ZONE_A_001:<password_hash>
# ESP32_ROOM_101:<password_hash>
# ESP32_ROOM_101_CTR:<password_hash>
# ESP32_ROOM_101_DOOR:<password_hash>
# ESP32_ROOM_102:<password_hash>
# ESP32_ROOM_102_B:<password_hash>
# ESP32_ROOM_102_C:<password_hash>
# ESP32_STORAGE_201:<password_hash>
# ESP32_STORAGE_201_B:<password_hash>
# ESP32_STORAGE_201_C:<password_hash>
# ESP32_HALL_001_A:<password_hash>
# ESP32_HALL_001_B:<password_hash>
# ESP32_HALL_001_C:<password_hash>
