# AIoTLibTQB IoT Circuit Simulator - Environment Configuration
# Copy this file to .env and adjust variables as needed

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_PER_DEVICE_AUTH=true
MQTT_DEVICE_PASSWORD=CHANGE_ME_LOCAL_DEV_DEVICE
MQTT_USERNAME=aiot_backend
MQTT_PASSWORD=CHANGE_ME_LOCAL_DEV_MQTT
MQTT_CLIENT_PREFIX=sim_node_
MQTT_KEEPALIVE=30

# Backend REST API Configuration (for idempotent provisioning & verification)
API_BASE_URL=http://localhost:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_LOCAL_DEV_ADMIN

# Simulator Engine Defaults
SIM_INTERVAL_MS=5000
SIM_SPEED=1
DEFAULT_SCENARIO=normal

# Safety configuration (set to true ONLY if intentionally testing against non-local brokers)
FORCE_REMOTE=false
