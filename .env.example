# =============================================================================
# AIoTLibTQB - Docker Compose & Runtime Environment Template
# Copy this file to .env and replace placeholder values with secure secrets
# =============================================================================

# 1. MongoDB Configuration
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT_PASSWORD
MONGO_DATABASE=aiot_identity_db

# 2. Mongo Express (only active when running with --profile dev)
ME_BASICAUTH_USERNAME=admin
ME_BASICAUTH_PASSWORD=CHANGE_ME_ME_ADMIN_PASSWORD

# 3. Backend Security & JWT (MUST be at least 64 characters for HMAC-SHA512)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_MINIMUM_HMAC_SHA512_SECRET_KEY_STRING_0123456789
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 4. MQTT Broker (Mosquitto) & Per-Device Authentication
MQTT_USERNAME=aiot_backend
MQTT_PASSWORD=CHANGE_ME_MQTT_BACKEND_PASSWORD
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=CHANGE_ME_MQTT_ADMIN_PASSWORD
MQTT_DEVICE_PASSWORD=CHANGE_ME_MQTT_DEVICE_PASSWORD
MQTT_PER_DEVICE_AUTH=true

# 5. Frontend Build/Runtime Public Endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws-aiot

# 6. IoT Simulator Defaults
DEFAULT_SCENARIO=demo
SIM_INTERVAL_MS=5000
SIM_SPEED=1
FORCE_REMOTE=true
